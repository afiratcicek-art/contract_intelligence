# ClauseIQ — Environment Variables
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Mirrors backend/core/config.py (plus noted deferred keys).
# Do not commit real secrets.

# ── Supabase (required) ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── AI — Anthropic (authoring / analysis; empty = features stay fail-closed) ─
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
GATE_MODEL=claude-haiku-4-5-20251001
ANALYSIS_MODEL=claude-sonnet-4-20250514
GATE_TIMEOUT_SECONDS=5
# Deprecated alias — prefer ANALYSIS_MODEL
# AI_MODEL=claude-sonnet-4-20250514

# ── AI — OpenAI embeddings only (dormant without key; ADR-0001) ───────────
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── LlamaParse (DEFERRED — not in active requirements until activated) ────
# LLAMAPARSE_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# Production boot refuses the default value below.
SECRET_KEY=change-me-in-production
# Optional webhook HMAC (WhatsApp / future); unused until wired
# WEBHOOK_SECRET=

# ── System prompt (gitignored file; mount securely in production) ─────────
SYSTEM_PROMPT_PATH=prompts/system.enc
SYSTEM_PROMPT_KEY=

# ── Application ───────────────────────────────────────────────────────────
# development | production
APP_ENV=development
# Comma-separated allowed browser origins (config: CORS_ORIGINS — not ALLOWED_ORIGINS)
CORS_ORIGINS=http://localhost:8501
BASE_URL=http://localhost:8000

# ── PDF preview render (null = download .docx only; intentional default) ──
RENDER_PROVIDER=null
GOTENBERG_URL=http://localhost:3000

# ── PDF worker (read by backend.workers.pdf_worker, not Settings) ─────────
# POLL_INTERVAL_SECONDS=15
# WORKER_BATCH_SIZE=3
