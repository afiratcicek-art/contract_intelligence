# ClauseIQ — Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── AI Providers ──────────────────────────────────────────
# Anthropic Claude — claude_service entegrasyonunda aktive edilir
ANTHROPIC_API_KEY=

# LlamaParse — PDF parsing (pydantic upgrade sonrası)
# Aktivasyon: backend/services/pdf_pipeline_service.py -> _extract_llamaparse()
LLAMAPARSE_API_KEY=

# ── Güvenlik ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# Supabase Webhook imza doğrulama anahtarı (Adım 3.5 sonrası)
WEBHOOK_SECRET=

# ── Uygulama ──────────────────────────────────────────────
# development | production
APP_ENV=development

# Production da React uygulamasının URL si (Adım 3.2)
# ALLOWED_ORIGINS=https://your-domain.com

BASE_URL=http://localhost:8000

# ── AI Model Konfigürasyonu ───────────────────────────────
AI_PROVIDER=anthropic
GATE_MODEL=claude-haiku-4-5-20251001
ANALYSIS_MODEL=claude-sonnet-4-20250514
GATE_TIMEOUT_SECONDS=5

# ── Sistem Prompt ─────────────────────────────────────────
SYSTEM_PROMPT_PATH=prompts/system.enc
SYSTEM_PROMPT_KEY=
